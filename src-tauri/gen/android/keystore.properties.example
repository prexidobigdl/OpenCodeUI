# Template for the Android release signing key.
#
# Copy to `keystore.properties` (same directory) and fill in the values.
# `keystore.properties` is git-ignored: it holds the signing password.
#
# Generate a key with:
#   keytool -genkeypair -v \
#     -keystore ~/keystore.jks -storetype PKCS12 \
#     -alias opencode -keyalg RSA -keysize 4096 -validity 10000 \
#     -storepass <password> -keypass <password> \
#     -dname "CN=OpenCodeUI, OU=Android, O=OpenCodeUI, C=NA"
#
# CI writes the same file from the repository secrets
# ANDROID_KEY_BASE64 / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD.

# Absolute path to the .jks file
storeFile=/absolute/path/to/keystore.jks
# Key alias inside the keystore
keyAlias=opencode
# Keystore + key password
password=change-me
# Key password (falls back to `password` when omitted)
keyPassword=change-me
